PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lms_enterprise?schema=public"

# JWT Authentication
JWT_SECRET="lms_enterprise_jwt_secret_key_change_in_production"
JWT_EXPIRES_IN="7d"
# Required for persistent OTP hashing; use a random server-side secret of at least 32 characters.
OTP_HMAC_SECRET=

# SMTP email delivery (use a dedicated non-production mailbox/credential in staging)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional; defaults to "Newtoz LMS" <SMTP_USER>
SMTP_FROM=
