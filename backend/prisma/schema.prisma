generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveMeetingPlatform {
  JITSI
  GOOGLE_MEET
  ZOOM
  CUSTOM
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  MARKED
  RESULT_RELEASED
}

enum ResourceVisibility {
  PUBLIC
  SUBSCRIBERS_ONLY
}

enum ResourceType {
  PAST_PAPER
  TUTE
  BOOK
}

// Multi-tenant School / Institution
model Tenant {
  id             String          @id @default(uuid())
  slug           String          @unique
  name           String
  domain         String?         @unique
  status         TenantStatus    @default(ACTIVE)
  plan           String          @default("PRO")
  settings       Json?
  users          User[]
  courses        Course[]
  packages       Package[]
  liveClasses    LiveClassSession[]
  assignments    Assignment[]
  libraryResources LibraryResource[]
  sportsEvents   SportsEvent[]
  announcements  Announcement[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([slug])
}

// Core User Account
model User {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email               String               @unique
  passwordHash        String
  role                Role
  firstName           String
  lastName            String
  avatarUrl           String?
  isActive            Boolean              @default(true)
  studentProfile      StudentProfile?
  teacherProfile      TeacherProfile?
  parentProfile       ParentProfile?
  sportsRegistrations SportsRegistration[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([tenantId, role])
  @@index([email])
}

model StudentProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentIdNo   String       @unique
  gradeLevel    String
  section       String?
  guardianId    String?
  guardian      ParentProfile? @relation(fields: [guardianId], references: [id])
  enrollments   Enrollment[]
  packageSubscriptions PackageSubscription[]
  liveAttendances LiveClassAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model TeacherProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo        String            @unique
  specialization    String
  title             String?
  bio               String?
  phone             String?
  address           String?
  city              String?
  district          String?
  province          String?
  postalCode        String?
  sltsRegNo         String?
  mediums           String[]          @default([])
  experienceYears   Int?              @default(0)
  qualifications    Json?             @default("[]")
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranch        String?
  bankBranchCode    String?
  publicSlug        String?           @unique
  youtubeUrl        String?
  telegramUrl       String?
  whatsappNumber    String?
  websiteUrl        String?
  coverImageUrl     String?
  rating            Float?            @default(4.9)
  isVerified        Boolean           @default(true)
  courses           Course[]
  packages          Package[]
  liveClasses       LiveClassSession[]
  assignments       Assignment[]
  libraryResources  LibraryResource[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ParentProfile {
  id            String           @id @default(uuid())
  userId        String           @unique
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber   String?
  students      StudentProfile[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model Course {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       TeacherProfile @relation(fields: [teacherId], references: [id])
  title         String
  code          String
  description   String?
  syllabus      Json?
  enrollments   Enrollment[]
  packageCourses PackageCourse[]
  liveClasses   LiveClassSession[]
  assignments   Assignment[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, code])
}

model Enrollment {
  id            String         @id @default(uuid())
  courseId      String
  course        Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade         Float?
  enrolledAt    DateTime       @default(now())

  @@unique([courseId, studentId])
}

model SportsEvent {
  id            String               @id @default(uuid())
  tenantId      String
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  sportType     String
  venue         String
  startDate     DateTime
  endDate       DateTime?
  status        EventStatus          @default(UPCOMING)
  registrations SportsRegistration[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([tenantId, status])
}

model SportsRegistration {
  id            String             @id @default(uuid())
  eventId       String
  event         SportsEvent        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jerseyNumber  Int?
  roleInTeam    String?
  status        RegistrationStatus @default(PENDING)
  notes         String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([eventId, userId])
}

model Announcement {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  content       String
  targetRole    Role?
  isPinned      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, targetRole])
}

model Package {
  id            String                @id @default(uuid())
  tenantId      String
  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title         String
  slug          String?
  description   String?
  price         Float                 @default(0.0)
  billingCycle  BillingCycle          @default(MONTHLY)
  durationDays  Int                   @default(30)
  features      Json?
  isPublished   Boolean               @default(true)
  courses       PackageCourse[]
  subscriptions PackageSubscription[]
  liveClasses   LiveClassSession[]
  libraryResources LibraryResource[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([tenantId, isPublished])
}

model PackageCourse {
  id        String   @id @default(uuid())
  packageId String
  package   Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
}

model PackageSubscription {
  id         String             @id @default(uuid())
  packageId  String
  package    Package            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  paidAmount Float              @default(0.0)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([packageId, status])
  @@index([studentId, status])
}

model LiveClassSession {
  id              String               @id @default(uuid())
  tenantId        String
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         TeacherProfile       @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?              @relation(fields: [courseId], references: [id], onDelete: SetNull)
  packageId       String?
  package         Package?             @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  topic           String?
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int                  @default(60)
  status          LiveClassStatus      @default(SCHEDULED)
  platform        LiveMeetingPlatform  @default(JITSI)
  meetingUrl      String?
  meetingId       String?
  passcode        String?
  recordingUrl    String?
  attendances     LiveClassAttendance[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([teacherId, status])
  @@index([courseId])
  @@index([packageId])
}

model LiveClassAttendance {
  id              String           @id @default(uuid())
  sessionId       String
  session         LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt        DateTime         @default(now())
  leftAt          DateTime?
  durationSeconds Int              @default(0)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Assignment {
  id                 String                 @id @default(uuid())
  tenantId           String
  tenant             Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId           String?
  course             Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId          String
  teacher            TeacherProfile         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectName        String?
  title              String
  instructions       String?
  topicName          String?
  dueDate            DateTime?
  maxMarks           Float                  @default(100.0)
  status             AssignmentStatus       @default(PUBLISHED)
  attachmentUrl      String?
  attachmentName     String?
  submissions        AssignmentSubmission[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([tenantId, status])
  @@index([teacherId])
  @@index([courseId])
}

model AssignmentSubmission {
  id                 String           @id @default(uuid())
  assignmentId       String
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textContent        String?
  fileAttachmentUrl  String?
  fileAttachmentName String?
  status             SubmissionStatus @default(SUBMITTED)
  marksObtained      Float?
  teacherFeedback    String?
  markedAt           DateTime?
  submittedAt        DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId])
}

model LibraryResource {
  id                 String              @id @default(uuid())
  tenantId           String
  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  packageId          String?
  package            Package?            @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  resourceType       ResourceType        @default(PAST_PAPER)
  subject            String
  topic              String?
  category           String?
  year               Int?
  medium             String?             // e.g. "Tamil", "English", "Sinhala"
  examType           String?             // e.g. "G.C.E. A/L", "Term Test"
  paperPart          String?             // e.g. "Part I (MCQ)", "Part II"
  fileUrl            String?
  fileName           String?
  fileSize           String?
  fileType           String              @default("pdf")
  coverImage         String?
  hasMarkingScheme   Boolean             @default(false)
  markingSchemeUrl   String?
  markingSchemeNotes String?
  timeAllowedMinutes Int?                @default(180)
  visibility         ResourceVisibility  @default(PUBLIC)
  status             String              @default("published")
  allowDownload      Boolean             @default(true)
  viewsCount         Int                 @default(0)
  downloadsCount     Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([tenantId, visibility])
  @@index([teacherId])
  @@index([subject])
  @@index([packageId])
}


