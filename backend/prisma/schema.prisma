generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  STUDENT
  TEACHER
  PARENT
  ADMIN
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TRIAL
}

enum EventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  WAITLISTED
  REJECTED
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  YEARLY
  ONE_TIME
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  PENDING
}

enum PaymentStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
  REFUNDED
}

enum TeamRole {
  CAPTAIN
  VICE_CAPTAIN
  PLAYER
  COACH
  SUPPORT_STAFF
}

enum NotificationType {
  REGISTRATION_CONFIRMATION
  PAYMENT_STATUS_CHANGE
  FIXTURE_SCHEDULE
  MATCH_REMINDER
  MATCH_RESULT
  TEAM_ANNOUNCEMENT
  SYSTEM_ALERT
}

enum LocationType {
  PROVINCE
  DISTRICT
}

enum MatchStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum BracketType {
  KNOCKOUT
  GROUP
  ROUND_ROBIN
  LEAGUE
}

enum BracketPosition {
  WINNER_BRACKET
  LOSER_BRACKET
  GROUP_STAGE
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum LiveMeetingPlatform {
  JITSI
  GOOGLE_MEET
  ZOOM
  CUSTOM
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SubmissionStatus {
  NOT_SUBMITTED
  SUBMITTED
  MARKED
  RESULT_RELEASED
}

enum ResourceVisibility {
  PUBLIC
  SUBSCRIBERS_ONLY
}

enum ResourceType {
  PAST_PAPER
  TUTE
  BOOK
}

// Multi-tenant School / Institution
model Tenant {
  id                    String                  @id @default(uuid())
  slug                  String                  @unique
  name                  String
  domain                String?                 @unique
  status                TenantStatus            @default(ACTIVE)
  plan                  String                  @default("PRO")
  settings              Json?
  users                 User[]
  courses               Course[]
  packages              Package[]
  subscriptions         TenantSubscription[]
  liveClasses           LiveClassSession[]
  assignments           Assignment[]
  libraryResources      LibraryResource[]
  sportsEvents          SportsEvent[]
  sportsDisciplines     SportsDiscipline[]
  sportsTeams           SportsTeam[]
  sportsTournaments     SportsTournament[]
  sportsFixtures        SportsFixture[]
  sportsPayments        SportsRegistrationPayment[] @relation("SportsPayments")
  sportsTeamMembers     SportsTeamMember[] @relation("SportsTeamMembers")
  sportsTeamInvitations SportsTeamInvitation[] @relation("SportsTeamInvitations")
  athleteProfiles       AthleteProfile[] @relation("AthleteProfiles")
  sportsLocations       SportsLocation[] @relation("SportsLocations")
  tournamentBrackets    TournamentBracket[] @relation("TournamentBrackets")
  bracketMatches        BracketMatch[] @relation("BracketMatches")
  liveMatchUpdates      LiveMatchUpdate[] @relation("LiveMatchUpdates")
  fixtureCalendarViews  FixtureCalendarView[] @relation("FixtureCalendarViews")
  announcements         Announcement[]

  // Phase 3: Notifications
  notifications         Notification[] @relation("Notifications")
  emailServices         EmailNotificationService[] @relation("EmailServices")
  smsServices           SMSNotificationService[] @relation("SMSServices")
  pushServices          PushNotificationService[] @relation("PushServices")
  notificationTemplates NotificationTemplate[] @relation("NotificationTemplates")
  deliveryLogs          NotificationDeliveryLog[] @relation("DeliveryLogs")

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  deletedAt             DateTime?

  @@index([slug])
}


model TenantSubscription {
  id           String             @id @default(uuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  amount       Decimal            @db.Decimal(12, 2)
  currency     String             @default("LKR")
  billingCycle BillingCycle       @default(MONTHLY)
  status       SubscriptionStatus @default(PENDING)
  startDate    DateTime
  endDate      DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([tenantId, status])
  @@index([status, startDate, endDate])
}


// Core User Account
model User {
  id                    String                @id @default(uuid())
  tenantId              String?
  tenant                Tenant?               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email                 String                @unique
  passwordHash          String
  role                  Role
  firstName             String
  lastName              String
  avatarUrl             String?
  isActive              Boolean               @default(true)
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  parentProfile         ParentProfile?
  superAdminProfile     SuperAdminProfile?
  sportsRegistrations   SportsRegistration[]
  athleteProfile        AthleteProfile?       @relation("AthleteProfile")
  teamMemberships       SportsTeamMember[]    @relation("TeamMemberships")
  teamInvitations       SportsTeamInvitation[] @relation("TeamInvitations")

  // Phase 3: Notifications
  notifications         Notification[] @relation("Notifications")

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenantId, role])
  @@index([email])
}

model StudentProfile {
  id                    String                 @id @default(uuid())
  userId                String                 @unique
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  studentIdNo           String                 @unique
  gradeLevel            String
  phoneNumber           String?
  section               String?
  guardianId            String?
  guardian              ParentProfile?         @relation(fields: [guardianId], references: [id])
  enrollments           Enrollment[]
  packageSubscriptions  PackageSubscription[]
  liveAttendances       LiveClassAttendance[]
  assignmentSubmissions AssignmentSubmission[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
}

model TeacherProfile {
  id                String             @id @default(uuid())
  userId            String             @unique
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeNo        String             @unique
  specialization    String
  title             String?
  bio               String?
  phone             String?
  address           String?
  city              String?
  district          String?
  province          String?
  postalCode        String?
  sltsRegNo         String?
  mediums           String[]           @default([])
  experienceYears   Int?               @default(0)
  qualifications    Json?              @default("[]")
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBranch        String?
  bankBranchCode    String?
  publicSlug        String?            @unique
  youtubeUrl        String?
  telegramUrl       String?
  whatsappNumber    String?
  websiteUrl        String?
  coverImageUrl     String?
  rating            Float?             @default(4.9)
  isVerified        Boolean            @default(true)
  courses           Course[]
  packages          Package[]
  liveClasses       LiveClassSession[]
  assignments       Assignment[]
  libraryResources  LibraryResource[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model ParentProfile {
  id          String           @id @default(uuid())
  userId      String           @unique
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  phoneNumber String?
  students    StudentProfile[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Course {
  id             String             @id @default(uuid())
  tenantId       String
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId      String
  teacher        TeacherProfile     @relation(fields: [teacherId], references: [id])
  title          String
  code           String
  description    String?
  syllabus       Json?
  enrollments    Enrollment[]
  packageCourses PackageCourse[]
  liveClasses    LiveClassSession[]
  assignments    Assignment[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([tenantId, code])
}

model Enrollment {
  id         String         @id @default(uuid())
  courseId   String
  course     Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grade      Float?
  enrolledAt DateTime       @default(now())

  @@unique([courseId, studentId])
}

model SportsEvent {
  id                  String               @id @default(uuid())
  tenantId            String
  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  disciplineId        String?
  discipline          SportsDiscipline?    @relation(fields: [disciplineId], references: [id], onDelete: SetNull)
  title               String
  sportType           String
  ageCategory         String?
  gender              String?
  fee                 Int                  @default(0)
  maxParticipants     Int?
  description         String?
  isTeamSport         Boolean              @default(false)
  venue               String
  startDate           DateTime
  endDate             DateTime?
  status              EventStatus          @default(UPCOMING)
  registrationOpenDate  DateTime?
  registrationCloseDate DateTime?          // When registration closes
  registrations       SportsRegistration[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([tenantId, status])
  @@index([registrationCloseDate])
}

model SportsDiscipline {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  category      String
  description   String        @default("")
  iconName      String        @default("Trophy")
  isTeamSport   Boolean       @default(false)
  events        SportsEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([tenantId, name])
}

model SportsRegistration {
  id                String                     @id @default(uuid())
  eventId           String
  event             SportsEvent                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId            String
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  jerseyNumber      Int?
  roleInTeam        String?
  status            RegistrationStatus        @default(PENDING)
  notes             String?
  registrationNumber String?
  athleteDetails    Json?
  paymentStatus     String                    @default("PENDING")
  totalAmount       Int                       @default(0)
  payments          SportsRegistrationPayment[] @relation("PaymentRecords")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([eventId, userId])
  @@index([registrationNumber])
}

model SportsTeam {
  id                String                 @id @default(uuid())
  tenantId          String
  tenant            Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sportName         String
  name              String
  coachName         String                 @default("")
  trainingSchedule  String                 @default("")
  status            String                 @default("active")
  playersCount      Int                    @default(0)
  players           Json                   @default("[]")
  members           SportsTeamMember[]     @relation("Members")
  invitations       SportsTeamInvitation[] @relation("Invitations")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([tenantId, sportName])
}

model SportsTournament {
  id                  String   @id @default(uuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                String
  sportName           String
  category            String
  format              String
  startDate           DateTime
  endDate             DateTime
  venue               String
  organizer           String
  teamsCount          Int      @default(0)
  participatingTeams  String[] @default([])
  status              String   @default("upcoming")
  trophyTitle         String
  description         String
  rules               String?
  currentRound        String?
  champion            String?
  runnerUp            String?
  fixtures            SportsFixture[]
  brackets           TournamentBracket[] @relation("Brackets")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([tenantId, sportName, status])
}

model SportsFixture {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tournamentId      String?
  tournament        SportsTournament? @relation(fields: [tournamentId], references: [id], onDelete: SetNull)
  sportName         String
  homeTeam          String
  awayTeam          String
  homeDistrict      String?
  awayDistrict      String?
  competitionName   String
  roundName         String?
  date              DateTime
  time              String
  venue             String
  status            MatchStatus @default(UPCOMING)
  homeScore         String?
  awayScore         String?
  outcome           String?
  recordedAt        DateTime?
  liveUpdates       LiveMatchUpdate[] @relation("LiveUpdates")
  bracketMatches    BracketMatch[] @relation("BracketFixtures")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([tenantId, sportName, date])
  @@index([tenantId, competitionName, status])
}

model Announcement {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title         String
  content       String
  targetRole    Role?
  priority      String?     @default("normal")
  authorName    String?     @default("Principal's Office")
  authorRole    String?     @default("ADMIN")
  targetAudience String?    @default("Platform-Wide (Everyone)")
  category      String?     @default("GENERAL")
  isPinned      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([tenantId, targetRole])
  @@index([tenantId, isPinned])
}

model Package {
  id               String                @id @default(uuid())
  tenantId         String
  tenant           Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId        String
  teacher          TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  title            String
  slug             String?
  description      String?
  price            Float                 @default(0.0)
  billingCycle     BillingCycle          @default(MONTHLY)
  durationDays     Int                   @default(30)
  features         Json?
  isPublished      Boolean               @default(true)
  courses          PackageCourse[]
  subscriptions    PackageSubscription[]
  liveClasses      LiveClassSession[]
  libraryResources LibraryResource[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([tenantId, isPublished])
}

model PackageCourse {
  id        String  @id @default(uuid())
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([packageId, courseId])
}

model PackageSubscription {
  id         String             @id @default(uuid())
  packageId  String
  package    Package            @relation(fields: [packageId], references: [id], onDelete: Cascade)
  studentId  String
  student    StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status     SubscriptionStatus @default(ACTIVE)
  startDate  DateTime           @default(now())
  endDate    DateTime
  paidAmount    Float              @default(0.0)
  paymentMethod String?            @default("CARD")
  receiptNo     String?
  bankRefNo     String?
  slipUrl       String?
  slipFileName  String?
  paymentNotes  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([packageId, status])
  @@index([studentId, status])
  @@index([receiptNo])
}

model LiveClassSession {
  id              String                @id @default(uuid())
  tenantId        String
  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId       String
  teacher         TeacherProfile        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  courseId        String?
  course          Course?               @relation(fields: [courseId], references: [id], onDelete: SetNull)
  packageId       String?
  package         Package?              @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title           String
  description     String?
  topic           String?
  startTime       DateTime
  endTime         DateTime?
  durationMinutes Int                   @default(60)
  status          LiveClassStatus       @default(SCHEDULED)
  platform        LiveMeetingPlatform   @default(JITSI)
  meetingUrl      String?
  meetingId       String?
  passcode        String?
  recordingUrl    String?
  attendances     LiveClassAttendance[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([tenantId, status])
  @@index([teacherId, status])
  @@index([courseId])
  @@index([packageId])
}

model LiveClassAttendance {
  id              String           @id @default(uuid())
  sessionId       String
  session         LiveClassSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId       String
  student         StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt        DateTime         @default(now())
  leftAt          DateTime?
  durationSeconds Int              @default(0)

  @@unique([sessionId, studentId])
  @@index([studentId])
}

model Assignment {
  id             String                 @id @default(uuid())
  tenantId       String
  tenant         Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  courseId       String?
  course         Course?                @relation(fields: [courseId], references: [id], onDelete: SetNull)
  teacherId      String
  teacher        TeacherProfile         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectName    String?
  title          String
  instructions   String?
  topicName      String?
  dueDate        DateTime?
  maxMarks       Float                  @default(100.0)
  status         AssignmentStatus       @default(PUBLISHED)
  attachmentUrl  String?
  attachmentName String?
  submissions    AssignmentSubmission[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([tenantId, status])
  @@index([teacherId])
  @@index([courseId])
}

model AssignmentSubmission {
  id                 String           @id @default(uuid())
  assignmentId       String
  assignment         Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId          String
  student            StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  textContent        String?
  fileAttachmentUrl  String?
  fileAttachmentName String?
  status             SubmissionStatus @default(SUBMITTED)
  marksObtained      Float?
  teacherFeedback    String?
  markedAt           DateTime?
  submittedAt        DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId])
}

model LibraryResource {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacherId          String
  teacher            TeacherProfile     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  packageId          String?
  package            Package?           @relation(fields: [packageId], references: [id], onDelete: SetNull)
  title              String
  description        String?
  resourceType       ResourceType       @default(PAST_PAPER)
  subject            String
  topic              String?
  category           String?
  year               Int?
  medium             String? // e.g. "Tamil", "English", "Sinhala"
  examType           String? // e.g. "G.C.E. A/L", "Term Test"
  paperPart          String? // e.g. "Part I (MCQ)", "Part II"
  fileUrl            String?
  fileName           String?
  fileSize           String?
  fileType           String             @default("pdf")
  coverImage         String?
  hasMarkingScheme   Boolean            @default(false)
  markingSchemeUrl   String?
  markingSchemeNotes String?
  timeAllowedMinutes Int?               @default(180)
  visibility         ResourceVisibility @default(PUBLIC)
  status             String             @default("published")
  allowDownload      Boolean            @default(true)
  viewsCount         Int                @default(0)
  downloadsCount     Int                @default(0)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, visibility])
  @@index([teacherId])
  @@index([subject])
  @@index([packageId])
}

model SportsRegistrationPayment {
  id                 String         @id @default(uuid())
  tenantId           String
  tenant             Tenant         @relation("SportsPayments", fields: [tenantId], references: [id], onDelete: Cascade)
  registrationId     String
  registration       SportsRegistration @relation("PaymentRecords", fields: [registrationId], references: [id], onDelete: Cascade)
  amount             Decimal        @db.Decimal(12, 2)
  currency           String         @default("LKR")
  paymentMethod      String         @default("BANK_TRANSFER") // BANK_TRANSFER, CARD, CHEQUE, CASH
  status             PaymentStatus  @default(PENDING)
  paymentSlipUrl     String?
  paymentSlipFileName String?
  receiptNumber      String?        @unique
  bankRefNo          String?
  notes              String?
  submittedAt        DateTime?
  approvedAt         DateTime?
  approvedBy         String?        // Admin ID who approved
  rejectedAt         DateTime?
  rejectedReason     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([registrationId, status])
  @@index([tenantId, status])
  @@index([receiptNumber])
  @@index([createdAt])
}

model SportsTeamMember {
  id            String     @id @default(uuid())
  tenantId      String
  tenant        Tenant     @relation("SportsTeamMembers", fields: [tenantId], references: [id], onDelete: Cascade)
  teamId        String
  team          SportsTeam @relation("Members", fields: [teamId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role          TeamRole   @default(PLAYER)
  jerseyNumber  Int?
  joinedAt      DateTime   @default(now())
  leftAt        DateTime?
  isActive      Boolean    @default(true)

  @@unique([teamId, userId])
  @@index([tenantId, teamId])
  @@index([userId])
}

model SportsTeamInvitation {
  id        String    @id @default(uuid())
  tenantId  String
  tenant    Tenant    @relation("SportsTeamInvitations", fields: [tenantId], references: [id], onDelete: Cascade)
  teamId    String
  team      SportsTeam @relation("Invitations", fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation("TeamInvitations", fields: [userId], references: [id], onDelete: Cascade)
  code      String    @unique
  status    String    @default("PENDING") // PENDING, ACCEPTED, REJECTED, EXPIRED
  expiresAt DateTime
  acceptedAt DateTime?
  rejectedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([teamId, userId])
  @@index([code])
  @@index([tenantId, status])
}

model AthleteProfile {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation("AthleteProfiles", fields: [tenantId], references: [id], onDelete: Cascade)
  userId            String      @unique
  user              User        @relation("AthleteProfile", fields: [userId], references: [id], onDelete: Cascade)
  dateOfBirth       DateTime?
  gender            String?     // Boys, Girls, Mixed
  schoolName        String?
  province          String?
  district          String?
  height            Float?      // in cm
  weight            Float?      // in kg
  bloodType         String?
  emergencyContact  String?
  achievements      Json?       @default("[]") // Array of achievement objects
  participationHistory Json?    @default("[]") // Array of past events
  sportsInterests   String[]    @default([])
  isTeamInterested  Boolean     @default(false)
  bio               String?
  profileImageUrl   String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([district])
  @@index([province])
  @@index([createdAt])
}

model SportsLocation {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation("SportsLocations", fields: [tenantId], references: [id], onDelete: Cascade)
  type      LocationType
  name      String
  code      String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, type, code])
  @@index([tenantId, type, isActive])
}

// Phase 2: Tournament Brackets and Live Scoring
model TournamentBracket {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation("TournamentBrackets", fields: [tenantId], references: [id], onDelete: Cascade)
  tournamentId    String
  tournament      SportsTournament @relation("Brackets", fields: [tournamentId], references: [id], onDelete: Cascade)
  type            BracketType
  stage           Int            @default(1) // 1 for group stage, 2-N for knockout rounds
  stageName       String         @default("Round 1")
  matchCount      Int            @default(0)
  matches         BracketMatch[] @relation("BracketMatches")
  status          String         @default("pending") // pending, in_progress, completed
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([tenantId, tournamentId, stage])
  @@index([tenantId, tournamentId, status])
}

model BracketMatch {
  id               String         @id @default(uuid())
  tenantId         String
  tenant           Tenant         @relation("BracketMatches", fields: [tenantId], references: [id], onDelete: Cascade)
  bracketId        String
  bracket          TournamentBracket @relation("BracketMatches", fields: [bracketId], references: [id], onDelete: Cascade)
  fixtureId        String?
  fixture          SportsFixture? @relation("BracketFixtures", fields: [fixtureId], references: [id], onDelete: SetNull)
  matchNumber      Int            // Position in bracket (1, 2, 3, etc)
  team1Id          String?
  team1Name        String?
  team1Score       Int?
  team2Id          String?
  team2Name        String?
  team2Score       Int?
  winnerId         String?        // ID of winning team/competitor
  winnerName       String?
  position         BracketPosition @default(WINNER_BRACKET)
  status           MatchStatus    @default(UPCOMING)
  scheduledDate    DateTime?
  scheduledTime    String?
  venue            String?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([tenantId, bracketId, matchNumber])
  @@index([tenantId, bracketId, status])
  @@index([tenantId, fixtureId])
}

// Live Match Updates
model LiveMatchUpdate {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("LiveMatchUpdates", fields: [tenantId], references: [id], onDelete: Cascade)
  fixtureId       String
  fixture         SportsFixture @relation("LiveUpdates", fields: [fixtureId], references: [id], onDelete: Cascade)
  homeScore       Int
  awayScore       Int
  period          Int      @default(1) // Half/Quarter/Set/Innings
  periodTime      String?  // Time within period
  event           String?  // Goal, Wicket, Foul, etc
  playerName      String?  // Player involved in event
  teamId          String?  // Team that scored/involved
  updateTime      DateTime @default(now())
  updatedBy       String   // Admin/Official ID who made the update
  createdAt       DateTime @default(now())

  @@index([tenantId, fixtureId, createdAt])
  @@index([tenantId, fixtureId, updateTime])
}

// Fixture Calendar support - extends SportsFixture
model FixtureCalendarView {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("FixtureCalendarViews", fields: [tenantId], references: [id], onDelete: Cascade)
  name            String
  filterCriteria  Json     @default("{}")
  createdBy       String
  isPublic        Boolean  @default(false)
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, isPublic])
}

// Phase 3: Notification System
model Notification {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("Notifications", fields: [tenantId], references: [id], onDelete: Cascade)
  recipientId     String
  recipient       User     @relation("Notifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type            NotificationType
  title           String
  message         String
  relatedEntityId String?  // Registration ID, Payment ID, Fixture ID, etc
  relatedEntityType String? // "REGISTRATION", "PAYMENT", "FIXTURE", "TEAM", etc
  read            Boolean  @default(false)
  readAt          DateTime?
  actionUrl       String?  // Deep link to related resource
  createdAt       DateTime @default(now())
  sentVia         String?  // "IN_APP", "EMAIL", "SMS"

  @@index([tenantId, recipientId, read])
  @@index([tenantId, recipientId, createdAt])
  @@index([tenantId, type])
}

// Email notification service configuration
model EmailNotificationService {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("EmailServices", fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String   // "SMTP", "SENDGRID", "AWS_SES", "MAILGUN"
  isActive        Boolean  @default(true)
  senderEmail     String
  senderName      String?

  // Encrypted provider credentials
  providerConfig  Json     // { apiKey, apiSecret, host, port, etc }

  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
}

// SMS notification service configuration
model SMSNotificationService {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("SMSServices", fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String   // "TWILIO", "AWS_SNS", "NEXMO", "FIREBASE"
  isActive        Boolean  @default(true)
  senderPhoneOrId String   // Phone number for Twilio, account ID for others

  // Encrypted provider credentials
  providerConfig  Json     // { accountSid, authToken, apiKey, etc }

  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
}

// Push notification service configuration
model PushNotificationService {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("PushServices", fields: [tenantId], references: [id], onDelete: Cascade)
  provider        String   // "FIREBASE", "ONESIGNAL", "EXPO"
  isActive        Boolean  @default(true)

  // Encrypted provider credentials
  providerConfig  Json     // { apiKey, serverKey, projectId, etc }

  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
}

// Notification template for consistency
model NotificationTemplate {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("NotificationTemplates", fields: [tenantId], references: [id], onDelete: Cascade)
  type            NotificationType
  channel         String   // "IN_APP", "EMAIL", "SMS", "PUSH"
  titleTemplate   String   // Supports {{variable}} placeholders
  messageTemplate String   // Supports {{variable}} placeholders
  isActive        Boolean  @default(true)

  createdBy       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, type, channel])
  @@index([tenantId, isActive])
}

// Notification delivery log for audit and retry
model NotificationDeliveryLog {
  id              String   @id @default(uuid())
  tenantId        String
  tenant          Tenant   @relation("DeliveryLogs", fields: [tenantId], references: [id], onDelete: Cascade)
  notificationId  String
  channel         String   // "IN_APP", "EMAIL", "SMS", "PUSH"
  recipientEmail  String?
  recipientPhone  String?
  recipientPushToken String?
  status          String   // "PENDING", "SENT", "DELIVERED", "FAILED"
  errorMessage    String?
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  nextRetryAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tenantId, notificationId])
  @@index([tenantId, status, createdAt])
  @@index([tenantId, nextRetryAt]) // For retry processing
}

model SuperAdminProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  fullName      String?
  preferredName String?
  phone         String?
  altPhone      String?
  address       String?
  city          String?
  district      String?
  province      String?
  postalCode    String?
  bio           String?
  dateOfBirth   DateTime?
  gender        String?
  languages     String?
  rootAuthorityId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
